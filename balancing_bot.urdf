<?xml version="1.0" encoding="utf-8"?>
<robot name="balancing_bot">
  <material name="dark"><color rgba="0.15 0.15 0.2 1.0"/></material>
  <material name="rubber"><color rgba="0.1 0.7 0.8 1.0"/></material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <mass value="2.5"/>
      <inertia ixx="0.0255" ixy="0" ixz="0" iyy="0.0201" iyz="0" izz="0.0081"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><box size="0.08 0.18 0.26"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><box size="0.08 0.18 0.26"/></geometry>
    </collision>
  </link>

  <link name="left_wheel">
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.00037" iyz="0" izz="0.0002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.05" length="0.025"/></geometry>
      <material name="rubber"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.05" length="0.025"/></geometry>
    </collision>
  </link>

  <link name="right_wheel">
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.00037" iyz="0" izz="0.0002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.05" length="0.025"/></geometry>
      <material name="rubber"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.05" length="0.025"/></geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.11 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.002" friction="0.005"/>
    <limit effort="15.0" velocity="40.0"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.11 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.002" friction="0.005"/>
    <limit effort="15.0" velocity="40.0"/>
  </joint>
</robot>
